# Gmail Configuration for Email Server
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Firebase Configuration (optional - currently hardcoded but can be moved here)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Server Configuration
SERVER_PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5174
STORAGE_BUCKET_NAME=fileshare-b0e2c.firebasestorage.app

# File Upload Settings
FILE_EXPIRY_HOURS=24
MAX_FILE_SIZE_MB=500

# Cloud Function URL (for production)
VITE_CLOUD_FUNCTION_URL=https://us-central1-fileshare-b0e2c.cloudfunctions.net/sendShareEmail
